# Copy to .env (git-ignored). Nothing in this file is a real credential.

# LLM used for discovery only (replay never calls a model). Cloud providers need their key below.
CUA_LLM_PROVIDER=ollama             # ollama (local, free) | anthropic | openai
# CUA_LLM_MODEL=qwen3:8b            # optional override (e.g. claude-sonnet-5-5)
# Local models via Ollama (no key): `ollama pull qwen3:8b`. Reasoning mode is slower per turn
# but much more reliable for small models on multi-screen flows.
CUA_OLLAMA_THINK=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Synthetic teller credentials for the local mock core (defaults of mock-corebank).
CU_ALPHA_COREBANK_USERNAME=teller01
CU_ALPHA_COREBANK_PASSWORD=Teller#2024!
CU_BETA_COREBANK_USERNAME=teller01
CU_BETA_COREBANK_PASSWORD=Teller#2024!

# Key for HMAC fingerprints of confidential outputs in persisted results (any random string).
# If unset, one is generated in .cua/fingerprint.key.
# CUA_FINGERPRINT_KEY=
