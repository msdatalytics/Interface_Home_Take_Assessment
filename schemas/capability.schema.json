{
  "$defs": {
    "AllOf": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "all_of",
          "default": "all_of",
          "title": "Kind",
          "type": "string"
        },
        "conditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "all_of": "#/$defs/AllOf",
                "any_of": "#/$defs/AnyOf",
                "element_visible": "#/$defs/ElementVisible",
                "text_visible": "#/$defs/TextVisible",
                "url_matches": "#/$defs/UrlMatches"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementVisible"
              },
              {
                "$ref": "#/$defs/UrlMatches"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              }
            ]
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnyOf": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "any_of",
          "default": "any_of",
          "title": "Kind",
          "type": "string"
        },
        "conditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "all_of": "#/$defs/AllOf",
                "any_of": "#/$defs/AnyOf",
                "element_visible": "#/$defs/ElementVisible",
                "text_visible": "#/$defs/TextVisible",
                "url_matches": "#/$defs/UrlMatches"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementVisible"
              },
              {
                "$ref": "#/$defs/UrlMatches"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              }
            ]
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "title": "By",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "digest": {
          "description": "Spec digest the approval is bound to; edits invalidate it.",
          "title": "Digest",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "by",
        "at",
        "digest"
      ],
      "title": "Approval",
      "type": "object"
    },
    "CapabilityMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "app": {
          "description": "App profile (vendor product) this capability targets.",
          "title": "App",
          "type": "string"
        },
        "app_versions": {
          "default": "*",
          "description": "PEP 440-style specifier, e.g. '>=4.2,<5'.",
          "title": "App Versions",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "draft"
        },
        "approvals": {
          "items": {
            "$ref": "#/$defs/Approval"
          },
          "title": "Approvals",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the canonical spec (see Capability.compute_digest).",
          "title": "Digest"
        }
      },
      "required": [
        "name",
        "version",
        "title",
        "description",
        "app",
        "provenance"
      ],
      "title": "CapabilityMetadata",
      "type": "object"
    },
    "CapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputSpec"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/OutputSpec"
          },
          "title": "Outputs",
          "type": "array"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/OutcomeSpec"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "entry": {
          "$ref": "#/$defs/EntrySpec"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "click": "#/$defs/ClickStep",
                "extract": "#/$defs/ExtractStep",
                "fill": "#/$defs/FillStep",
                "navigate": "#/$defs/NavigateStep",
                "press": "#/$defs/PressStep",
                "select": "#/$defs/SelectStep"
              },
              "propertyName": "action"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NavigateStep"
              },
              {
                "$ref": "#/$defs/ClickStep"
              },
              {
                "$ref": "#/$defs/FillStep"
              },
              {
                "$ref": "#/$defs/SelectStep"
              },
              {
                "$ref": "#/$defs/PressStep"
              },
              {
                "$ref": "#/$defs/ExtractStep"
              }
            ]
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "success": {
          "description": "Final checkpoint proving the goal was reached.",
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/AllOf",
              "any_of": "#/$defs/AnyOf",
              "element_visible": "#/$defs/ElementVisible",
              "text_visible": "#/$defs/TextVisible",
              "url_matches": "#/$defs/UrlMatches"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextVisible"
            },
            {
              "$ref": "#/$defs/ElementVisible"
            },
            {
              "$ref": "#/$defs/UrlMatches"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            }
          ],
          "title": "Success"
        }
      },
      "required": [
        "steps",
        "success"
      ],
      "title": "CapabilitySpec",
      "type": "object"
    },
    "ClickStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "Intent of the step in operator language.",
          "title": "Title",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/Risk",
          "default": "read"
        },
        "expect": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "all_of": "#/$defs/AllOf",
                  "any_of": "#/$defs/AnyOf",
                  "element_visible": "#/$defs/ElementVisible",
                  "text_visible": "#/$defs/TextVisible",
                  "url_matches": "#/$defs/UrlMatches"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextVisible"
                },
                {
                  "$ref": "#/$defs/ElementVisible"
                },
                {
                  "$ref": "#/$defs/UrlMatches"
                },
                {
                  "$ref": "#/$defs/AllOf"
                },
                {
                  "$ref": "#/$defs/AnyOf"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Post-condition checkpoint: the state this step must lead to.",
          "title": "Expect"
        },
        "timeout_ms": {
          "default": 15000,
          "maximum": 120000,
          "minimum": 500,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "source": {
          "default": "llm",
          "description": "Who produced this step during recording.",
          "enum": [
            "llm",
            "human",
            "author"
          ],
          "title": "Source",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the step exists (from the discovery run).",
          "title": "Rationale"
        },
        "action": {
          "const": "click",
          "default": "click",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "id",
        "title",
        "target"
      ],
      "title": "ClickStep",
      "type": "object"
    },
    "CssLocator": {
      "additionalProperties": false,
      "description": "Structural selector. Last resort: brittle across versions and tenant-specific (generated\ncontrol names differ per installation). Kept so a recording is never left without a fallback.",
      "properties": {
        "strategy": {
          "const": "css",
          "default": "css",
          "title": "Strategy",
          "type": "string"
        },
        "selector": {
          "title": "Selector",
          "type": "string"
        }
      },
      "required": [
        "selector"
      ],
      "title": "CssLocator",
      "type": "object"
    },
    "ElementVisible": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "element_visible",
          "default": "element_visible",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "target"
      ],
      "title": "ElementVisible",
      "type": "object"
    },
    "EntrySpec": {
      "additionalProperties": false,
      "properties": {
        "requires_session": {
          "default": true,
          "title": "Requires Session",
          "type": "boolean"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start page relative to base URL; defaults to the app profile's session entry path.",
          "title": "Path"
        }
      },
      "title": "EntrySpec",
      "type": "object"
    },
