      ],
      "title": "FillStep",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "description": "Identifies a frame/window region. ``None`` on a :class:`Target` means \"search all frames\".",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Frame name attribute (e.g. 'main').",
          "title": "Name"
        },
        "url_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fnmatch-style glob on the frame URL path.",
          "title": "Url Path"
        }
      },
      "title": "FrameRef",
      "type": "object"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ValueType"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "default": "internal"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex the value must fully match.",
          "title": "Pattern"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "max_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Synthetic example only - never real data.",
          "title": "Example"
        }
      },
      "required": [
        "name",
        "type",
        "description"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "LabelLocator": {
      "additionalProperties": false,
      "description": "A form control identified by the visible label a human reads next to it - whether or not\nthe label is programmatically associated (``<label for>``, ``aria-labelledby``) or merely sits\nin the adjacent table cell, which is the norm in legacy server-rendered apps.",
      "properties": {
        "strategy": {
          "const": "label",
          "default": "label",
          "title": "Strategy",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "role": {
          "description": "Control role: textbox | combobox | checkbox | radio | button",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "label",
        "role"
      ],
      "title": "LabelLocator",
      "type": "object"
    },
    "LabelValueLocator": {
      "additionalProperties": false,
      "description": "The value displayed next to a label in a key/value layout (``Confirmation Number: CB-1``).",
      "properties": {
        "strategy": {
          "const": "label_value",
          "default": "label_value",
          "title": "Strategy",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "LabelValueLocator",
      "type": "object"
    },
    "LiteralValue": {
      "additionalProperties": false,
      "properties": {
        "literal": {
          "description": "Constant, non-sensitive value (e.g. a fixed dropdown choice).",
          "title": "Literal",
          "type": "string"
        }
      },
      "required": [
        "literal"
      ],
      "title": "LiteralValue",
      "type": "object"
    },
    "NavigateStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "Intent of the step in operator language.",
          "title": "Title",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/Risk",
          "default": "read"
        },
        "expect": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "all_of": "#/$defs/AllOf",
                  "any_of": "#/$defs/AnyOf",
                  "element_visible": "#/$defs/ElementVisible",
                  "text_visible": "#/$defs/TextVisible",
                  "url_matches": "#/$defs/UrlMatches"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextVisible"
                },
                {
                  "$ref": "#/$defs/ElementVisible"
                },
                {
                  "$ref": "#/$defs/UrlMatches"
                },
                {
                  "$ref": "#/$defs/AllOf"
                },
                {
                  "$ref": "#/$defs/AnyOf"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Post-condition checkpoint: the state this step must lead to.",
          "title": "Expect"
        },
        "timeout_ms": {
          "default": 15000,
          "maximum": 120000,
          "minimum": 500,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "source": {
          "default": "llm",
          "description": "Who produced this step during recording.",
          "enum": [
            "llm",
            "human",
            "author"
          ],
          "title": "Source",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the step exists (from the discovery run).",
          "title": "Rationale"
        },
        "action": {
          "const": "navigate",
          "default": "navigate",
          "title": "Action",
          "type": "string"
        },
        "path": {
          "description": "Path relative to the tenant's base URL.",
          "title": "Path",
          "type": "string"
        },
        "frame": {
