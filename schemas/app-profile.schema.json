      },
      "required": [
        "session"
      ],
      "title": "AppProfileSpec",
      "type": "object"
    },
    "ClickStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "Intent of the step in operator language.",
          "title": "Title",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/Risk",
          "default": "read"
        },
        "expect": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "all_of": "#/$defs/AllOf",
                  "any_of": "#/$defs/AnyOf",
                  "element_visible": "#/$defs/ElementVisible",
                  "text_visible": "#/$defs/TextVisible",
                  "url_matches": "#/$defs/UrlMatches"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextVisible"
                },
                {
                  "$ref": "#/$defs/ElementVisible"
                },
                {
                  "$ref": "#/$defs/UrlMatches"
                },
                {
                  "$ref": "#/$defs/AllOf"
                },
                {
                  "$ref": "#/$defs/AnyOf"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Post-condition checkpoint: the state this step must lead to.",
          "title": "Expect"
        },
        "timeout_ms": {
          "default": 15000,
          "maximum": 120000,
          "minimum": 500,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "source": {
          "default": "llm",
          "description": "Who produced this step during recording.",
          "enum": [
            "llm",
            "human",
            "author"
          ],
          "title": "Source",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the step exists (from the discovery run).",
          "title": "Rationale"
        },
        "action": {
          "const": "click",
          "default": "click",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "id",
        "title",
        "target"
      ],
      "title": "ClickStep",
      "type": "object"
    },
    "CssLocator": {
      "additionalProperties": false,
