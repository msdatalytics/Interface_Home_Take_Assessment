    },
    "LabelLocator": {
      "additionalProperties": false,
      "description": "A form control identified by the visible label a human reads next to it - whether or not\nthe label is programmatically associated (``<label for>``, ``aria-labelledby``) or merely sits\nin the adjacent table cell, which is the norm in legacy server-rendered apps.",
      "properties": {
        "strategy": {
          "const": "label",
          "default": "label",
          "title": "Strategy",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "role": {
          "description": "Control role: textbox | combobox | checkbox | radio | button",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "label",
        "role"
      ],
      "title": "LabelLocator",
      "type": "object"
    },
    "LabelValueLocator": {
      "additionalProperties": false,
