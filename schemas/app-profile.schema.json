    "Risk": {
      "description": "Side-effect class of a step. Ordered: ``read < write < irreversible``.\n\n* ``read``         - no server-side state change (navigation, search, typing into a form).\n* ``write``        - changes state but is reversible / not yet committed (e.g. \"Continue\" to a review page).\n* ``irreversible`` - commits a business transaction (submit, post, transfer, close, delete).",
      "enum": [
        "read",
        "write",
        "irreversible"
      ],
      "title": "Risk",
      "type": "string"
    },
    "RoleLocator": {
      "additionalProperties": false,
      "description": "Accessibility role + accessible name. Survives layout/CSS changes; maps 1:1 to desktop\naccessibility APIs. Unavailable when the control has no accessible name (common in legacy).",
      "properties": {
        "strategy": {
          "const": "role",
          "default": "role",
          "title": "Strategy",
          "type": "string"
        },
        "role": {
