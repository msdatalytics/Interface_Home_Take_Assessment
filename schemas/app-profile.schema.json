                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementVisible"
              },
              {
                "$ref": "#/$defs/UrlMatches"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              }
            ]
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "AppProfileMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        },
        "product": {
          "title": "Product",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name",
        "version",
        "vendor",
        "product"
      ],
      "title": "AppProfileMetadata",
      "type": "object"
    },
    "AppProfileSpec": {
      "additionalProperties": false,
